{
  "uid": "paywallet-overview",
  "title": "PayWallet overview",
  "tags": ["paywallet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "row", "title": "Business", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {"id": 2, "type": "timeseries", "title": "Money moved per minute (R$)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1}, "fieldConfig": {"defaults": {"unit": "currencyBRL"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (type) (rate(paywallet_ledger_amount_brl_total[5m])) * 60", "legendFormat": "{{type}}", "exemplar": true}]},
    {"id": 3, "type": "timeseries", "title": "Ledger movements per minute", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (type) (rate(paywallet_ledger_transactions_total[5m])) * 60", "legendFormat": "{{type}}", "exemplar": true}]},
    {"id": 4, "type": "timeseries", "title": "Risk decisions per minute", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (decision) (rate(paywallet_fraud_assessments_total[5m])) * 60", "legendFormat": "{{decision}}", "exemplar": true}]},
    {"id": 5, "type": "timeseries", "title": "Risk rules triggered (1h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (rule) (increase(paywallet_fraud_rules_total[1h]))", "legendFormat": "{{rule}}", "exemplar": true}]},
    {"id": 6, "type": "row", "title": "Queues and messaging", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "panels": []},
    {"id": 7, "type": "timeseries", "title": "Pending items", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "paywallet_queue_pending", "legendFormat": "{{queue}}", "exemplar": true}]},
    {"id": 8, "type": "timeseries", "title": "Oldest pending item", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "paywallet_queue_oldest_age_seconds", "legendFormat": "{{queue}}", "exemplar": true}]},
    {"id": 9, "type": "timeseries", "title": "Outbox events per minute", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (topic) (rate(paywallet_outbox_published_total[5m])) * 60", "legendFormat": "published {{topic}}", "exemplar": true}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (topic) (rate(paywallet_outbox_failures_total[5m])) * 60", "legendFormat": "failed {{topic}}"}]},
    {"id": 10, "type": "timeseries", "title": "Dead letters (1h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (topic) (increase(paywallet_kafka_dead_letters_total[1h]))", "legendFormat": "{{topic}}", "exemplar": true}]},
    {"id": 11, "type": "row", "title": "API and partners", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}, "panels": []},
    {"id": 12, "type": "timeseries", "title": "Requests per second by status", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"paywallet\"}[1m]))", "legendFormat": "{{status}}", "exemplar": true}]},
    {"id": 13, "type": "timeseries", "title": "API latency p95 by route", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"paywallet\"}[5m])))", "legendFormat": "{{uri}}", "exemplar": true}]},
    {"id": 14, "type": "timeseries", "title": "Partner latency p95", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, partner, operation) (rate(paywallet_partner_requests_seconds_bucket[5m])))", "legendFormat": "{{partner}} {{operation}}", "exemplar": true}]},
    {"id": 15, "type": "timeseries", "title": "Partner errors per minute", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 43}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (partner, error) (rate(paywallet_partner_requests_seconds_count{error!=\"none\"}[5m])) * 60", "legendFormat": "{{partner}} {{error}}", "exemplar": true}]},
    {"id": 16, "type": "row", "title": "Runtime", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 51}, "panels": []},
    {"id": 17, "type": "timeseries", "title": "JVM heap used", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 52}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(jvm_memory_used_bytes{job=\"paywallet\", area=\"heap\"})", "legendFormat": "heap", "exemplar": true}]},
    {"id": 18, "type": "timeseries", "title": "Database connections", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "hikaricp_connections_active{job=\"paywallet\"}", "legendFormat": "active", "exemplar": true}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "hikaricp_connections_pending{job=\"paywallet\"}", "legendFormat": "waiting"}]}
  ]
}
